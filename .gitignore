# ==============================================================================
# SMACKGYM Monorepo — Production .gitignore
# Aligned with Turborepo, React 19, Expo SDK 52+, Node.js 26, & MERN Pro Standards
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Package Managers & Dependencies
# ------------------------------------------------------------------------------
node_modules/
.pnp/
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# ------------------------------------------------------------------------------
# 2. Build Outputs, Compilers & Bundlers
# ------------------------------------------------------------------------------
dist/
build/
out/
.next/
!.next/cache/
.output/
.serverless/
.tsbuildinfo
*.tsbuildinfo

# Turborepo Cache
.turbo/

# ------------------------------------------------------------------------------
# 3. Mobile App (Expo & React Native)
# ------------------------------------------------------------------------------
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Android Native Outputs
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/
apps/mobile/android/captures/
*.apk
*.aab

# iOS Native Outputs
apps/mobile/ios/build/
apps/mobile/ios/Pods/
apps/mobile/ios/*.xcworkspace/xcuserdata/
apps/mobile/ios/*.xcodeproj/xcuserdata/
*.ipa

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.test
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ------------------------------------------------------------------------------
# 5. Logs & Telemetry
# ------------------------------------------------------------------------------
logs/
server/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 6. Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
junit.xml

# ------------------------------------------------------------------------------
# 7. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# IDE & Editor Configs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# ------------------------------------------------------------------------------
# 8. Local Uploads & Temporary Directories
# ------------------------------------------------------------------------------
uploads/
server/uploads/
tmp/
temp/
docs/Note.txt
