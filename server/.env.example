# SMACKGYM Server Environment Configuration
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/smackgym?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# JWT RS256 Key Pair (Optional in development - generated automatically in-memory if omitted)
# JWT_ACCESS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
